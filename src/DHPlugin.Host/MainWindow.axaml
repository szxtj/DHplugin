<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DHPlugin.Host"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
        x:Class="DHPlugin.Host.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="DHPlugin Host - 插件平台"
        Width="1200" Height="700"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="*,40">
        <!-- 主内容区 -->
        <Grid Grid.Row="0" ColumnDefinitions="280,*">
            <!-- 左侧边栏 - 插件管理 -->
            <Border Grid.Column="0" BorderBrush="#303030" BorderThickness="0,0,1,0" Background="#252525">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- 标题和按钮 -->
                    <Border Grid.Row="0" Padding="15" BorderBrush="#303030" BorderThickness="0,0,0,1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="插件管理" 
                                       FontSize="16" 
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF"/>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                                <Button Content="+ 安装" 
                                        Click="OnInstallPlugin"
                                        Padding="8,4"/>
                                <Button Content="&#8635;" 
                                        Click="OnRefresh"
                                        ToolTip.Tip="刷新"
                                        Padding="8,4"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 插件列表 -->
                    <ListBox Grid.Row="1" 
                             ItemsSource="{Binding Plugins}"
                             SelectedItem="{Binding SelectedPlugin}"
                             Margin="0"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,8" Margin="4,2" CornerRadius="6">
                                    <Border.Styles>
                                        <Style Selector="Border:pointerover">
                                            <Setter Property="Background" Value="#353535"/>
                                        </Style>
                                    </Border.Styles>
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Manifest.Name}"
                                                       FontWeight="Bold"
                                                       FontSize="13"
                                                       Foreground="#FFFFFF"/>
                                            <Border Background="{Binding State, Converter={x:Static vm:StateColorConverter.Instance}}"
                                                    CornerRadius="3"
                                                    Padding="4,1"
                                                    Margin="6,0,0,0">
                                                <TextBlock Text="{Binding State}"
                                                           FontSize="9"
                                                           Foreground="White"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Manifest.Id}"
                                                   FontSize="10"
                                                   Foreground="#666666"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 操作按钮 -->
                    <Border Grid.Row="2" Padding="15" BorderBrush="#303030" BorderThickness="0,1,0,0">
                        <StackPanel Spacing="8" IsVisible="{Binding IsPluginSelected}">
                            <Button Content="&#9654; 启用" 
                                    Click="OnEnablePlugin"
                                    HorizontalAlignment="Stretch"/>
                            <Button Content="&#8214; 禁用" 
                                    Click="OnDisablePlugin"
                                    HorizontalAlignment="Stretch"/>
                            <Button Content="卸载" 
                                    Click="OnUninstallPlugin"
                                    Classes="Danger"
                                    HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 右侧 - 插件内容区 -->
            <Grid Grid.Column="1">
                <!-- 浏览器式标签页导航（包含内容区） -->
                <TabControl ItemsSource="{Binding PluginTabs}"
                            SelectedItem="{Binding ActiveTabPluginId, Mode=TwoWay}"
                            Background="Transparent"
                            BorderThickness="0"
                            Margin="0"
                            IsVisible="{Binding HasActivePlugin}">
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <TabItem Header="{Binding PluginName}"
                                     Background="Transparent"
                                     Foreground="#CCCCCC"
                                     Padding="16,10"
                                     Margin="2,0,0,0">
                                <TabItem.Styles>
                                    <Style Selector="TabItem">
                                        <Setter Property="Background" Value="#252525"/>
                                        <Setter Property="Foreground" Value="#888888"/>
                                        <Setter Property="CornerRadius" Value="4,4,0,0"/>
                                    </Style>
                                    <Style Selector="TabItem:selected">
                                        <Setter Property="Background" Value="#1E1E1E"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Style>
                                    <Style Selector="TabItem:pointerover">
                                        <Setter Property="Background" Value="#353535"/>
                                        <Setter Property="Foreground" Value="#CCCCCC"/>
                                    </Style>
                                </TabItem.Styles>
                            </TabItem>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate x:DataType="vm:PluginTab">
                            <ContentControl Content="{Binding Content}"/>
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>

                <!-- 空状态 -->
                <StackPanel IsVisible="{Binding HasNoActivePlugin}" 
                            VerticalAlignment="Center" 
                            HorizontalAlignment="Center"
                            Spacing="16">
                    <TextBlock Text="&#9633;" FontSize="64" HorizontalAlignment="Center"
                               ToolTip.Tip="暂无活动的插件"/>
                    <TextBlock Text="暂无活动的插件" 
                               Foreground="#666666"
                               FontSize="16"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="从左侧启用一个插件来开始使用" 
                               Foreground="#555555"
                               FontSize="12"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="1" Background="#252525" BorderBrush="#303030" BorderThickness="0,1,0,0" Padding="15,8">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" 
                           Text="DHPlugin Host v1.0.0" 
                           Foreground="#666666"
                           FontSize="12"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="15">
                    <TextBlock Foreground="#666666" FontSize="12">
                        <Run Text="插件数："/>
                        <Run Text="{Binding Plugins.Count}" Foreground="#FFFFFF"/>
                    </TextBlock>
                    <TextBlock Foreground="#666666" FontSize="12">
                        <Run Text="活动插件："/>
                        <Run Text="{Binding PluginTabs.Count}" Foreground="#FFFFFF"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
