<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:DHPlugin.Host"
             x:Class="DHPlugin.Host.App"
             RequestedThemeVariant="Dark">
    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <!-- Provide font fallback for Linux/X11: Inter (embedded) → Noto Sans → DejaVu → system sans-serif.
             This ensures Chinese text and symbols render correctly even without emoji fonts installed. -->
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Inter,Noto Sans,Noto Sans CJK SC,DejaVu Sans,sans-serif"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="FontFamily" Value="Inter,Noto Sans,Noto Sans CJK SC,DejaVu Sans,sans-serif"/>
        </Style>
    </Application.Styles>
</Application>
