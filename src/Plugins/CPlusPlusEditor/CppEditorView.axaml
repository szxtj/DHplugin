<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CPlusPlusEditor"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="CPlusPlusEditor.CppEditorView"
             x:DataType="vm:CppEditorViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Background="#1E1E1E">
        <!-- 工具栏 -->
        <Border Grid.Row="0" Padding="10" Background="#252525">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="🔨 编译" Click="OnCompile" IsEnabled="{Binding CanCompile}"/>
                <Button Content="▶️ 运行" Click="OnRun" IsEnabled="{Binding CanRun}"/>
                <Button Content="🧹 清空输出" Click="OnClearOutput"/>
                
                <Separator Width="20"/>
                
                <TextBlock Text="{Binding Status}" 
                           VerticalAlignment="Center"
                           Foreground="#888888"/>
            </StackPanel>
        </Border>

        <!-- 编辑器和输出 -->
        <Grid Grid.Row="1" RowDefinitions="*,Auto,*">
            <!-- 代码编辑器 -->
            <Border Grid.Row="0" Margin="10,10,10,5" Background="#1E1E1E">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Background="#2D2D30" Padding="8,4">
                        <TextBlock Text="main.cpp" Foreground="#CCCCCC" FontSize="12"/>
                    </Border>
                    <ScrollViewer Grid.Row="1" 
                                  HorizontalScrollBarVisibility="Auto" 
                                  VerticalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding Code}"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 FontFamily="Consolas,Monaco,Monospace"
                                 FontSize="14"
                                 Background="#1E1E1E"
                                 Foreground="#D4D4D4"
                                 CaretBrush="White"
                                 SelectionBrush="#264F78"
                                 Padding="10"
                                 TextWrapping="NoWrap"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 分隔条 -->
            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#303030"/>

            <!-- 输出区域 -->
            <Border Grid.Row="2" Margin="10,5,10,10" Background="#1E1E1E">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Background="#2D2D30" Padding="8,4">
                        <TextBlock Text="输出" Foreground="#CCCCCC" FontSize="12"/>
                    </Border>
                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding Output}"
                                 IsReadOnly="True"
                                 FontFamily="Consolas,Monaco,Monospace"
                                 FontSize="13"
                                 Background="#1E1E1E"
                                 Foreground="#CCCCCC"
                                 Padding="10"
                                 TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
